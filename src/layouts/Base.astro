---
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getData, img } from '../lib/data.mjs';

const { seo = {}, title, description, image, type = 'website', jsonLd = [], current = '' } = Astro.props;
const { settings, clinics } = await getData();
const site = (settings.siteUrl || Astro.site?.toString() || '').replace(/\/$/, '');
const canonical = site + Astro.url.pathname;
const metaTitle = seo?.metaTitle || title || settings.seo.metaTitle;
const metaDescription = seo?.metaDescription || description || settings.seo.metaDescription;
const ogRaw = img(seo?.ogImage, 1200) || image || img(settings.seo?.ogImage, 1200) || '/img/doctor-desk.webp';
const ogImage = ogRaw.startsWith('http') ? ogRaw : site + ogRaw;
const noIndex = Boolean(seo?.noIndex);

const physician = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  '@id': site + '/#physician',
  name: settings.doctorName,
  description: settings.role,
  url: site + '/',
  image: site + '/img/doctor-hero.webp',
  telephone: settings.phones.map((p) => '+2' + p),
  medicalSpecialty: ['Obstetric', 'Gynecologic'],
  sameAs: Object.values(settings.social || {}).filter(Boolean),
  location: clinics.map((c) => ({
    '@type': 'MedicalClinic',
    name: `${c.name} - ${c.city}`,
    hasMap: c.mapUrl,
    address: { '@type': 'PostalAddress', streetAddress: c.address, addressLocality: c.locality, addressRegion: c.region, addressCountry: 'EG' },
    openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: c.daysEn, opens: c.opens, closes: c.closes },
  })),
};
const ld = [physician, ...jsonLd];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={canonical}>
  {noIndex && <meta name="robots" content="noindex,nofollow">}
  <meta property="og:type" content={type}>
  <meta property="og:locale" content="ar_EG">
  <meta property="og:site_name" content={settings.doctorName}>
  <meta property="og:title" content={metaTitle}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#de82c4">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alexandria:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&display=swap">
  <script is:inline>document.documentElement.classList.add('js')</script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <Header settings={settings} current={current} />
  <slot />
  <Footer settings={settings} />
  <a class="fab" href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener" aria-label="تواصلي على واتساب"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/></svg></a>
  <script>
    // ظهور الأقسام بنعومة مع السكرول
    const els = document.querySelectorAll('[data-reveal]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach((el, i) => { el.style.setProperty('--d', `${(Number(el.dataset.reveal) || 0) * 90}ms`); io.observe(el); });
    } else els.forEach((el) => el.classList.add('in'));

    // حركة خفيفة للأشكال في الواجهة مع الماوس
    const stage = document.getElementById('stage');
    if (stage && !reduce && matchMedia('(pointer:fine)').matches) {
      const items = stage.querySelectorAll('[data-depth]');
      addEventListener('mousemove', (e) => {
        const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        items.forEach((it) => { const d = +it.dataset.depth; it.style.transform = `translate(${x * d}px,${y * d}px)`; });
      }, { passive: true });
    }

    // الهيدر يبان أوضح بعد السكرول
    const head = document.querySelector('header.site');
    const onScroll = () => head && head.classList.toggle('scrolled', scrollY > 24);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // نسخ الأرقام
    document.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => {
      const el = document.getElementById(b.dataset.copy);
      const ok = () => { b.textContent = 'اتنسخ'; setTimeout(() => (b.textContent = 'نسخ'), 1500); };
      const sel = () => { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s.removeAllRanges(); s.addRange(r); };
      try { navigator.clipboard.writeText(el.textContent).then(ok, sel); } catch { sel(); }
    }));
  </script>
</body>
</html>
