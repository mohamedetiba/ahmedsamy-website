---
import Base from '../../layouts/Base.astro';
import Book from '../../components/Book.astro';
import { getData, img, richText } from '../../lib/data.mjs';

export async function getStaticPaths() {
  const { services } = await getData();
  return services.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}
const { slug } = Astro.props;
const { settings, services, clinics, posts } = await getData();
const s = services.find((x) => x.slug === slug);
const others = services.filter((x) => x.slug !== slug);
const related = posts.filter((p) => p.service === slug).slice(0, 3);
const site = settings.siteUrl.replace(/\/$/, '');
const ld = [
  { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.title, about: { '@type': 'MedicalProcedure', name: s.title }, url: `${site}/services/${s.slug}/`, reviewedBy: { '@id': site + '/#physician' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'الخدمات', item: site + '/#services' },
    { '@type': 'ListItem', position: 3, name: s.title, item: `${site}/services/${s.slug}/` },
  ] },
];
const html = richText(s.body);
---
<Base seo={s.seo} title={`${s.title} | ${settings.doctorName}`} description={s.short} image={img(s.image, 1200)} jsonLd={ld} current="services">
<main class="wrap inner">
  <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span><a href="/#services">الخدمات</a><span>/</span><span aria-current="page">{s.title}</span></nav>
  <section class="page-hero">
    <div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div>
    <span class="kicker rise"><span class="dot pulse"></span>{s.tag}</span>
    <h1 class="rise" style="--d:90ms">{s.title}</h1>
    <p class="lede rise" style="--d:180ms">{s.short}</p>
    {s.points?.length > 0 && <div class="chips rise" style="--d:260ms">{s.points.map((p) => <span><i class="dot"></i>{p}</span>)}</div>}
    <div class="ctas rise" style="--d:320ms"><a class="btn btn-main" href="#book">احجزي موعدك</a><a class="btn btn-soft" href={`https://wa.me/${settings.whatsapp}?text=${encodeURIComponent('أهلاً، عندي استفسار عن ' + s.title)}`} target="_blank" rel="noopener">اسألي على واتساب</a></div>
  </section>

  <div class="article-grid">
    <article class="prose" data-reveal set:html={html} />
    <aside class="side" data-reveal="1">
      <div class="side-card">
        <h2>احجزي في أقرب عيادة</h2>
        {clinics.map((c) => <div class="mini-clinic"><b>{c.name}</b><span>{(c.days || []).join(' · ')} · {c.hours}</span></div>)}
        <a class="btn btn-main" href="#book">احجزي موعدك</a>
      </div>
      {related.length > 0 && <div class="side-card"><h2>مقالات عن الموضوع</h2>{related.map((p) => <a class="side-link" href={`/blog/${p.slug}/`}>{p.title}</a>)}</div>}
    </aside>
  </div>

  <section class="more-services" aria-labelledby="ms-h">
    <h2 id="ms-h" data-reveal>خدمات تانية</h2>
    <div class="strip left">{others.map((o) => <a href={`/services/${o.slug}/`}><i class="dot"></i>{o.title}</a>)}</div>
  </section>
</main>
<Book settings={settings} clinics={clinics} />
</Base>
