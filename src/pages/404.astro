---
import Base from '../layouts/Base.astro';
---
<script is:inline>
  // روابط لوحة التحكم الداخلية: ارجع لأولها بدل صفحة 404
  (function(){var i=location.pathname.indexOf('/studio/');if(i>-1&&location.pathname.length>i+8){location.replace(location.pathname.slice(0,i+8));}})();
</script>
<Base title="الصفحة مش موجودة" description="الصفحة اللي بتدوري عليها مش موجودة." seo={{ noIndex: true }}>
<main class="wrap inner">
  <section class="page-hero">
    <div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div>
    <span class="kicker"><span class="dot pulse"></span>404</span>
    <h1>الصفحة دي مش موجودة</h1>
    <p class="lede">ممكن يكون الرابط اتغير. ارجعي للرئيسية أو احجزي موعدك على طول.</p>
    <div class="ctas"><a class="btn btn-main" href="/">الرئيسية</a><a class="btn btn-soft" href="/#book">احجزي موعدك</a></div>
  </section>
</main>
</Base>
